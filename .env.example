# ==============================================================================
# Recovery Orchestrator — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ==============================================================================

# --- App ---
APP_NAME=recovery-orchestrator
APP_ENV=development            # development | staging | production
APP_VERSION=0.1.0
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1

# --- CORS ---
# Comma-separated list of allowed origins for the frontend dev server / deployed app.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (Phase 2) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/recovery_orchestrator
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@localhost:5432/recovery_orchestrator

# --- Razorpay (Phase 4) ---
# Leave blank to run in SIMULATED_RAZORPAY mode only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=simulated        # simulated | test | live  (live is never used in this project)

# --- LLM (Phase 6) ---
# One frontier LLM provider. Leave blank until Phase 6.
LLM_PROVIDER=anthropic         # anthropic | openai
LLM_API_KEY=
LLM_MODEL=

# --- Security ---
# Random secret used to sign internal tokens / request IDs if needed.
APP_SECRET_KEY=change-me-in-production

# API key required for state-changing endpoints (POST /simulate/events,
# POST /recovery-cases/{id}/run, POST /evaluation/run). Fails safe: if
# left blank, those endpoints are DENIED (503), never silently open.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# In-memory rate limiting (per-process; see app/core/rate_limit.py for
# why this doesn't need Redis at MVP scale).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SIMULATE_EVENTS_PER_MINUTE=300
RATE_LIMIT_EVALUATION_PER_MINUTE=10
